# Copy this file to .env before running: docker compose up --build
MARIADB_DATABASE=adr_manager
MARIADB_USER=adr_manager
MARIADB_PASSWORD=adr_manager
MARIADB_ROOT_PASSWORD=change-me-root-password
MARIADB_PORT=3306

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-password
KEYCLOAK_PORT=8081
KEYCLOAK_REALM=adr-manager
KEYCLOAK_SERVICE_CLIENT_SECRET=dev-api-client-secret

API_PORT=8080
SPA_PORT=3000
ELASTICSEARCH_PORT=9200
LOGSTASH_PORT=5044
KIBANA_PORT=5601
KIBANA_ENCRYPTED_SAVED_OBJECTS_KEY=adr-manager-local-kibana-key-2026!

# Keep the default unless `docker info` reports a different Docker Root Dir.
DOCKER_ROOT_DIR=/var/lib/docker
